      { value: "claude-opus-4-20250514", label: "Claude Opus 4", desc: "ฉลาดที่สุด เหมาะกับงานซับซ้อน", badge: "Premium" },
      { value: "claude-haiku-4-5-20251001", label: "Claude Haiku 4.5", desc: "เร็วมาก ประหยัดที่สุด", badge: "ประหยัด" },
