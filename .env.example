# ── Admin ─────────────────────────────────────────────────
ADMIN_API_KEY=botify2569

# ── Supabase Auth (ใหม่ — สำหรับ Dashboard login) ─────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── AI Provider ───────────────────────────────────────────
AI_PROVIDER=claude
CLAUDE_KEY=sk-ant-...
# OPENAI_KEY=sk-...
# GEMINI_KEY=AIza...
# TYPHOON_KEY=...

# ── LINE Client 1 ────────────────────────────────────────
LINE_TOKEN_1=xxx
LINE_BOTID_1=Uxxxx
OWNER_LINE_ID_1=Uxxxx

# ── Facebook Client 1 ────────────────────────────────────
# FB_TOKEN_1=xxx
# FB_PAGEID_1=xxx
# FB_VERIFY_TOKEN=kingvision_verify

# ── Google Sheets ─────────────────────────────────────────
SHEET_ID_1=xxx
GOOGLE_CREDS={"type":"service_account",...}

# ── Payment (ร้านค้า) ─────────────────────────────────────
PROMPTPAY_NUMBER=095-585-1136

# ── Payment Gateway (SaaS Subscription) ──────────────────
# Stripe (ไม่บังคับ — ใส่เมื่อต้องการรับบัตรเครดิต/debit)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Omise (ไม่บังคับ — ใส่เมื่อต้องการรับ PromptPay QR / บัตรเครดิต)
# OMISE_SECRET_KEY=skey_test_...
# OMISE_PUBLIC_KEY=pkey_test_...

# URLs หลัง payment สำเร็จ/ยกเลิก (default: /dashboard?payment=success|cancel)
# PAYMENT_SUCCESS_URL=/dashboard?payment=success
# PAYMENT_CANCEL_URL=/dashboard?payment=cancel

# ── Email / SMTP (สำหรับ verify email + reset password) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=app-password-here
# SMTP_FROM=BOTIFY <noreply@yourdomain.com>
# APP_URL=https://botify.yourdomain.com

# ── Security ──────────────────────────────────────────────
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
NODE_ENV=development

# ── Optional ──────────────────────────────────────────────
