# ==========================================
# BOTIFY V4 - Environment Variables
# ==========================================

# ─── Core & Server ───────────────────────
PORT=3000
NODE_ENV=development
APP_URL=https://botify-v4.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
ADMIN_API_KEY=your_super_secret_admin_key

# ─── Database (Supabase) ──────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# ─── AI Configuration (Default) ───────────
AI_PROVIDER=claude
AI_FALLBACK_CHAIN=claude,deepseek,openai,gemini,typhoon
CLAUDE_MODEL=claude-3-5-sonnet-latest
CLAUDE_KEY=sk-ant-xxxx
OPENAI_MODEL=gpt-4o
OPENAI_KEY=sk-proj-xxxx
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_KEY=xxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_KEY=sk-xxxx
TYPHOON_MODEL=typhoon-v2-70b-instruct
TYPHOON_KEY=xxxx

# ─── Redis (Optional for Scaling) ─────────
REDIS_URL=redis://default:password@host:port

# ─── Google Sheets Integration ────────────
# Must be a valid JSON string of the Service Account credentials
GOOGLE_CREDS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ─── Payment Gateways ─────────────────────
# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Omise
OMISE_SECRET_KEY=skey_test_xxxx
OMISE_PUBLIC_KEY=pkey_test_xxxx
OMISE_WEBHOOK_SECRET=webhook_xxxx
# Payment Redirects
PAYMENT_SUCCESS_URL=/dashboard?payment=success
PAYMENT_CANCEL_URL=/dashboard?payment=cancel

# ─── Email Service ────────────────────────
RESEND_API_KEY=re_xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="BOTIFY <noreply@botify.app>"

# ─── Social & Notifications ───────────────
FB_VERIFY_TOKEN=your_custom_fb_verify_token
ADMIN_LINE_TOKEN=line_notify_token_for_super_admin
PROMPTPAY_NUMBER=0812345678

# ─── System Settings ──────────────────────
LOW_STOCK_LIMIT=3
FOLLOWUP_HOURS=24
UNPAID_REMINDER_HOURS=2
UNPAID_MAX_REMINDERS=3

# ─── Legacy Single-Tenant Settings (Fallback) ───
# SHOP_NAME_1=MyShop
# LINE_TOKEN_1=xxxx
# LINE_BOTID_1=xxxx
# FB_TOKEN_1=xxxx
# FB_PAGEID_1=xxxx
# SHEET_ID_1=xxxx
# OWNER_LINE_ID_1=xxxx
